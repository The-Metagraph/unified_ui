{
  "name": "web-ui-assets",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "npm run build:css && npm run build:elm",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./css/app.css -o ./dist/app.css --minify",
    "build:elm": "elm make src/Main.elm --output=./dist/app.js --optimize",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i ./css/app.css -o ./dist/app.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "daisyui": "^4.12.24",
    "elm": "^0.19.1-6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
