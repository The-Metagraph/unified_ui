        "file": ".spec/specs/element_protocol.spec.md",
        "id": "unified_iur.element_protocol.any_fallback",
        "priority": "must",
        "stability": "stable",
        "statement": "The protocol shall define an `Any` fallback that returns empty children and metadata with `type: :unknown`.",
        "subject_id": "unified_iur.element_protocol"
      },
      {
        "file": ".spec/specs/element_protocol.spec.md",
        "id": "unified_iur.element_protocol.children_contract",
        "priority": "must",
        "stability": "stable",
        "statement": "Element protocol implementations shall return child elements for container/composite structs and an empty list for leaf structs.",
        "subject_id": "unified_iur.element_protocol"
      },
      {
        "file": ".spec/specs/element_protocol.spec.md",
        "id": "unified_iur.element_protocol.metadata_contract",
        "priority": "must",
        "stability": "stable",
        "statement": "Element protocol implementations shall return metadata maps containing a stable element type plus renderer-relevant properties.",
        "subject_id": "unified_iur.element_protocol"
      },
      {
        "file": ".spec/specs/layouts.spec.md",
        "id": "unified_iur.layouts.child_union_support",
        "priority": "must",
        "stability": "stable",
        "statement": "The `UnifiedIUR.Layouts.child` type shall include core widgets, dialog/feedback widgets, input-builder widgets, and nested layouts.",
        "subject_id": "unified_iur.layouts"
      },
      {
        "file": ".spec/specs/layouts.spec.md",
        "id": "unified_iur.layouts.container_fields",
        "priority": "must",
        "stability": "stable",
        "statement": "`VBox` and `HBox` shall define children plus spacing, alignment, justification, padding, style, and visibility fields for layout configuration.",
        "subject_id": "unified_iur.layouts"
      },
      {
        "file": ".spec/specs/layouts.spec.md",
        "id": "unified_iur.layouts.element_passthrough",
        "priority": "must",
        "stability": "stable",
        "statement": "Element protocol implementations for `VBox` and `HBox` shall return the layout `children` list unchanged for traversal.",
        "subject_id": "unified_iur.layouts"
      },
      {
        "file": ".spec/specs/package.spec.md",
        "id": "unified_iur.package.platform_agnostic_data_contract",
        "priority": "must",
        "stability": "stable",
        "statement": "The package shall represent user interfaces as immutable Elixir structs and protocol implementations without embedding renderer-specific runtime logic.",
        "subject_id": "unified_iur.package"
      },
      {
        "file": ".spec/specs/package.spec.md",
        "id": "unified_iur.package.shared_ui_surface",
        "priority": "must",
        "stability": "stable",
        "statement": "The package shall expose widgets, layouts, style, and element traversal modules as a shared UI contract for upstream DSLs and downstream platform renderers.",
        "subject_id": "unified_iur.package"
      },
      {
        "file": ".spec/specs/package.spec.md",
        "id": "unified_iur.package.spec_led_tooling_available",
        "priority": "must",
        "stability": "stable",
        "statement": "The package shall include Spec Led tooling in dev and test dependencies so local and CI spec verification tasks can run.",
        "subject_id": "unified_iur.package"
      },
      {
        "file": ".spec/specs/style.spec.md",
        "id": "unified_iur.style.merge_many",
        "priority": "must",
        "stability": "stable",
        "statement": "`Style.merge_many/1` shall reduce style lists in order and skip nil entries during the merge fold.",
        "subject_id": "unified_iur.style"
      },
      {
        "file": ".spec/specs/style.spec.md",
        "id": "unified_iur.style.merge_pair",
        "priority": "must",
        "stability": "stable",
        "statement": "`Style.merge/2` shall return the non-nil operand when either side is nil and otherwise combine styles with deduplicated attributes and right-side value precedence.",
        "subject_id": "unified_iur.style"
      },
      {
        "file": ".spec/specs/style.spec.md",
        "id": "unified_iur.style.new_constructor",
        "priority": "must",
        "stability": "stable",
        "statement": "`Style.new/1` shall build a `UnifiedIUR.Style` struct from keyword attributes while preserving module defaults for omitted fields.",
        "subject_id": "unified_iur.style"
      },
      {
        "file": ".spec/specs/style.spec.md",
        "id": "unified_iur.style.struct_shape",
        "priority": "must",
        "stability": "stable",
        "statement": "The style struct shall include foreground/background colors, text attributes, spacing fields, size constraints, and alignment options.",
        "subject_id": "unified_iur.style"
      },
      {
        "file": ".spec/specs/widgets.spec.md",
        "id": "unified_iur.widgets.core_catalog",
        "priority": "must",
        "stability": "stable",
        "statement": "The library shall define core widget structs for text, inputs, charts, tabular data, menus, tabs, and tree navigation under `UnifiedIUR.Widgets`.",
        "subject_id": "unified_iur.widgets"
      },
      {
        "file": ".spec/specs/widgets.spec.md",
        "id": "unified_iur.widgets.dialog_feedback_catalog",
        "priority": "must",
        "stability": "stable",
        "statement": "The library shall define dialog and feedback widgets (`DialogButton`, `Dialog`, `AlertDialog`, `Toast`) with defaults for visibility and interaction behavior.",
        "subject_id": "unified_iur.widgets"
      },
      {
        "file": ".spec/specs/widgets.spec.md",
        "id": "unified_iur.widgets.input_builder_catalog",
        "priority": "must",
        "stability": "stable",
        "statement": "The library shall define dynamic input widgets (`PickListOption`, `PickList`, `FormField`, `FormBuilder`) that model options/fields separately from containers.",
        "subject_id": "unified_iur.widgets"
      },
      {
        "file": ".spec/specs/widgets.spec.md",
        "id": "unified_iur.widgets.top_level_type_aliases",
        "priority": "must",
        "stability": "stable",
        "statement": "The top-level `UnifiedIUR` module shall expose type aliases for supported widget structs, including dialog/feedback and input-builder additions.",
        "subject_id": "unified_iur.widgets"
      }
    ],
    "scenarios": [
      {
        "covers": [
          "unified_iur.element_protocol.children_contract",
          "unified_iur.element_protocol.metadata_contract"
        ],
        "file": ".spec/specs/element_protocol.spec.md",
        "given": [
          "a dialog with nested content and dialog buttons"
        ],
        "id": "unified_iur.element_protocol.dialog_children_and_metadata",
        "subject_id": "unified_iur.element_protocol",
        "then": [
          "children preserve content-first ordering followed by configured buttons",
          "metadata reports `type: :dialog` and the dialog lifecycle fields"
        ],
        "when": [
          "callers inspect the dialog through `Element.children/1` and `Element.metadata/1`"
        ]
      },
      {
        "covers": [
          "unified_iur.element_protocol.children_contract",
          "unified_iur.element_protocol.metadata_contract"
        ],
        "file": ".spec/specs/element_protocol.spec.md",
        "given": [
          "a form builder with multiple field descriptors and submit configuration"
        ],
        "id": "unified_iur.element_protocol.form_builder_children_and_metadata",
        "subject_id": "unified_iur.element_protocol",
        "then": [
          "children return field descriptors in declaration order",
          "metadata reports action, submit callback, and submit label fields"
        ],
        "when": [
          "callers inspect the form builder through `Element.children/1` and `Element.metadata/1`"
        ]
      },
      {
        "covers": [
          "unified_iur.element_protocol.children_contract",
          "unified_iur.element_protocol.metadata_contract"
        ],
        "file": ".spec/specs/element_protocol.spec.md",
        "given": [
          "a pick list with explicit options and interactive selection fields"
        ],
        "id": "unified_iur.element_protocol.pick_list_children_and_metadata",
        "subject_id": "unified_iur.element_protocol",
        "then": [
          "children return the configured option structs",
          "metadata reports selection, searchability, and select callback fields"
        ],
        "when": [
          "callers inspect the pick list through `Element.children/1` and `Element.metadata/1`"
        ]
      },
      {
        "covers": [
          "unified_iur.layouts.child_union_support",
          "unified_iur.layouts.element_passthrough"
        ],
        "file": ".spec/specs/layouts.spec.md",
        "given": [
          "a `VBox` containing a dialog and a pick list"
        ],
        "id": "unified_iur.layouts.extension_widgets_in_children",
        "subject_id": "unified_iur.layouts",
        "then": [
          "both extension widgets are preserved in order"
        ],
        "when": [
          "callers inspect both the `children` field and `Element.children/1`"
        ]
      },
      {
        "covers": [
          "unified_iur.widgets.dialog_feedback_catalog"
        ],
        "file": ".spec/specs/widgets.spec.md",
        "given": [
          "default `AlertDialog` and `Toast` structs"
        ],
        "id": "unified_iur.widgets.alert_and_toast_defaults",
        "subject_id": "unified_iur.widgets",
        "then": [
          "alert defaults include `severity: :info`, `modal: true`, and `closable: true`",
          "toast defaults include `severity: :info`, `duration: 3000`, and `visible: true`"
        ],
        "when": [
          "the structs are instantiated without overrides"
        ]
      }
    ],
